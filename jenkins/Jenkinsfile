pipeline {
  agent any

  parameters {
    booleanParam(name: 'SKIP_TERRAFORM', defaultValue: false, description: 'Skip Terraform execution')
    booleanParam(name: 'SKIP_ANSIBLE', defaultValue: false, description: 'Skip Ansible execution')
    booleanParam(name: 'INSTALL_METALLB', defaultValue: true, description: 'Install MetalLB')
    booleanParam(name: 'INSTALL_INGRESS', defaultValue: true, description: 'Install Nginx Ingress Controller')
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    LIBVIRT_URI = 'qemu:///system'
    ANSIBLE_INVENTORY = 'ansible/inventory.ini'
    ANSIBLE_STDOUT_CALLBACK = 'yaml'
    ANSIBLE_HOST_KEY_CHECKING = 'False'
    SSH_KEY_PATH = '/root/.ssh/id_ed25519'  // root key path
  }

  stages {
    stage('Ensure Libvirt Default Pool') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        script {
          retry(5) {
            sh '''
              set -e
              if ! virsh pool-info default >/dev/null 2>&1; then
                virsh pool-define-as default dir --target /var/lib/libvirt/images
              fi
              virsh pool-info default | grep -q "^State:.*running" || virsh pool-start default
              virsh pool-autostart default
            '''
          }
        }
      }
    }

    stage('Prepare Base Image') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        sh '''
          BASE_IMAGE="/var/lib/libvirt/images/ubuntu-24.04-server-cloudimg-amd64.img"
          BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
          if [ ! -f "$BASE_IMAGE" ]; then
            echo "Downloading base image..."
            wget "$BASE_IMAGE_URL" -O "$BASE_IMAGE" --progress=dot:giga
          else
            echo "Base image already present, skipping download."
          fi
        '''
      }
    }

    stage('Checkout Code') {
      steps {
        git url: 'git@github.com:bogdandragosvasile/k8s-libvirt-cluster.git', branch: 'local', credentialsId: 'github-ssh-key'
      }
    }

    stage('Terraform Init') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform init'
        }
      }
    }

    stage('Terraform Plan') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          withCredentials([string(credentialsId: 'kube-ssh-public-key', variable: 'KUBE_SSH_PUBLIC_KEY')]) {
            sh '''
              terraform plan -var="kube_ssh_public_key=$KUBE_SSH_PUBLIC_KEY" -out=plan.tfout
            '''
          }
        }
      }
    }

    stage('Terraform Apply') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform apply -auto-approve plan.tfout'
        }
      }
    }

    stage('Generate Ansible Vars File') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform output -json > outputs.json'
        }
        sh '''
          jq -r '
            ["---"],
            "# Kubernetes Configuration",
            "K8S_VERSION: 1.30.1-1.1",
            "K8S_API_SERVER_PORT: 6443",
            "",
            "# Network Configuration",
            "VIRTUAL_IP: \\"192.168.122.100\\"",
            "VIRTUAL_IP_PORT: 6443",
            "IP_HOST_LB1: 192.168.122.51",
            "IP_HOST_LB2: 192.168.122.52",
            "IP_HOST_CP1: 192.168.122.101",
            "IP_HOST_CP2: 192.168.122.102",
            "IP_HOST_CP3: 192.168.122.103",
            "IP_HOST_W1: 192.168.122.201",
            "",
            "# Pod Network Configuration",
            "POD_CIDR_FLANNEL: 10.244.0.0/16",
            "POD_CIDR_CALICO: 192.168.0.0/16",
            "VERSION_CALICO: \\"v3.26.1\\"",
            "",
            "# Authentication",
            "PASSWORD_KUBEADMIN: \\"kubeadmin\\"",
            "PASSWORD_KEEPALIVED: \\"fW/19P0JzwNqIveyXfnhLXswVBUSFF4d3oMyVSi3g/U=\\"",
            "ansible_python_interpreter: /usr/bin/python3",
            "",
            "# VM IPs (auto-updated by Jenkins):",
            "vm_ips:"
          ] + (
            .vm_ips | to_entries | map("  \(.key): \"\(.value)\"")
          ) | .[] > ansible/vars.yaml
        '''
        sh 'cat ansible/vars.yaml'
      }
    }

    stage('Wait for SSH Access') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        script {
          def ips = sh(script: "jq -r '.vm_ips | to_entries[] | .value' terraform/outputs.json", returnStdout: true).trim().split('\n')
          echo "VM IPs detected for SSH wait: ${ips}"
          withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-root-ssh-key', keyFileVariable: 'SSH_KEY')]) {
            for (ip in ips) {
              retry(15) {
                sh "ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i ${SSH_KEY} ubuntu@${ip} true"
              }
            }
          }
        }
      }
    }

    stage('Run Ansible Playbook') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        dir('ansible') {
          sh '''
            ansible-playbook -i inventory.ini main.yaml --extra-vars @vars.yaml -vvv --diff
          '''
        }
      }
    }

    stage('Verify Cluster Status') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        dir('ansible') {
          sh '''
            ansible -i inventory.ini control_plane_init -m shell -a "kubectl get nodes -o wide" --extra-vars @vars.yaml
            ansible -i inventory.ini control_plane_init -m shell -a "kubectl get pods --all-namespaces" --extra-vars @vars.yaml
            ansible -i inventory.ini control_plane_init -m shell -a "kubectl cluster-info" --extra-vars @vars.yaml
          '''
        }
      }
    }

    stage('Install MetalLB') {
      when { expression { params.INSTALL_METALLB } }
      steps {
        script {
          def lbIp = sh(script: "jq -r '.vm_ips.loadbalancer1' terraform/outputs.json", returnStdout: true).trim()
          withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-root-ssh-key', keyFileVariable: 'SSH_KEY')]) {
            sh """
              scp -o StrictHostKeyChecking=no -i ${SSH_KEY} scripts/install-metallb.sh ubuntu@${lbIp}:/tmp/
              ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${lbIp} 'chmod +x /tmp/install-metallb.sh && /tmp/install-metallb.sh'
            """
          }
        }
      }
    }

    stage('Install Nginx Ingress Controller') {
      when { expression { params.INSTALL_INGRESS } }
      steps {
        script {
          def lbIp = sh(script: "jq -r '.vm_ips.loadbalancer1' terraform/outputs.json", returnStdout: true).trim()
          withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-root-ssh-key', keyFileVariable: 'SSH_KEY')]) {
            sh """
              scp -o StrictHostKeyChecking=no -i ${SSH_KEY} scripts/install-nginx-ingress.sh ubuntu@${lbIp}:/tmp/
              ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${lbIp} 'chmod +x /tmp/install-nginx-ingress.sh && /tmp/install-nginx-ingress.sh'
            """
          }
        }
      }
    }

    stage('Final Cluster Summary') {
      steps {
        script {
          def cpIp = sh(script: "jq -r '.vm_ips.kcontrolplane1' terraform/outputs.json", returnStdout: true).trim()
          withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-root-ssh-key', keyFileVariable: 'SSH_KEY')]) {
            sh """
              ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${cpIp} kubectl get nodes -o wide
              ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${cpIp} kubectl get pods -n kube-system
              ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${cpIp} kubectl get pods -n metallb-system || echo "MetalLB not installed"
            """
          }
        }
      }
    }
  }

  post {
    always {
      dir('ansible') {
        withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-root-ssh-key', keyFileVariable: 'SSH_KEY')]) {
          sh """
            echo "Collecting cluster status logs"
            ansible -i inventory.ini control_plane_init -m shell -a "kubectl get nodes" --extra-vars @vars.yaml || echo "Failed to get nodes"
          """
        }
      }
      echo 'Pipeline completed.'
    }

    success {
      echo '\033[32m[SUCCESS] Deployment finished successfully!\033[0m'
    }

    failure {
      echo '\033[31m[FAILURE] Deployment failed, check logs.\033[0m'
    }
  }
}
