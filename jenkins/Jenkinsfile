pipeline {
  agent {
    docker {
      image 'bogdandragos/jenkins-k8s-libvirt-agent:latest'
      args """
        --user 0
        --privileged
        --network host
        -v /var/run/libvirt/libvirt-sock:/var/run/libvirt/libvirt-sock
        -v /run/libvirt:/run/libvirt
        -v /var/lib/libvirt/images:/var/lib/libvirt/images
        -v /root/.ssh:/root/.ssh:ro
      """
      reuseNode true
    }
  }

  parameters {
    booleanParam(name: 'SKIP_TERRAFORM', defaultValue: true, description: 'Skip Terraform infrastructure provisioning stages')
    booleanParam(name: 'SKIP_ANSIBLE', defaultValue: true, description: 'Skip Ansible configuration management stages') 
    booleanParam(name: 'INSTALL_METALLB', defaultValue: true, description: 'Install MetalLB load balancer for external service access')
    booleanParam(name: 'INSTALL_INGRESS', defaultValue: true, description: 'Install Nginx Ingress Controller with MetalLB integration')
    booleanParam(name: 'ENABLE_AUTOSCALING', defaultValue: true, description: 'Enable Kubernetes autoscaling capabilities (HPA + Cluster Autoscaler)')
    string(name: 'BRANCH', defaultValue: 'master', description: 'Git branch to deploy from')
    choice(name: 'DEPLOYMENT_TYPE', choices: ['full', 'infrastructure-only', 'configuration-only', 'addons-only', 'autoscaling-only'], description: 'Type of deployment to perform')
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    // Enhanced build naming for better visibility
    buildDiscarder(logRotator(numToKeepStr: '20'))
    // Add build name setter for better identification
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    LIBVIRT_URI         = 'qemu:///system'
    ANSIBLE_INVENTORY   = 'inventory.ini'
    KUBE_SSH_PUBLIC_KEY = credentials('kube-ssh-public-key')
    ANSIBLE_HOST_KEY_CHECKING = 'False'
    ANSIBLE_STDOUT_CALLBACK = 'yaml'
    // Enhanced environment variables
    PIPELINE_VERSION    = '1.1.1'
    CLUSTER_NAME        = 'k8s-libvirt-cluster'
    DEPLOYMENT_TIMESTAMP = "${new Date().format('yyyy-MM-dd_HH-mm-ss')}"
  }

  stages {
    stage('🚀 Pipeline Initialization') {
      steps {
        script {
          // Set build name for better visibility
          currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.DEPLOYMENT_TYPE} - ${params.BRANCH}"
          currentBuild.description = "Deployment Type: ${params.DEPLOYMENT_TYPE}<br/>Branch: ${params.BRANCH}<br/>Timestamp: ${env.DEPLOYMENT_TIMESTAMP}"
          
          echo "🎯 Starting Kubernetes Cluster Deployment"
          echo "📋 Deployment Configuration:"
          echo "   - Type: ${params.DEPLOYMENT_TYPE}"
          echo "   - Branch: ${params.BRANCH}"
          echo "   - Skip Terraform: ${params.SKIP_TERRAFORM}"
          echo "   - Skip Ansible: ${params.SKIP_ANSIBLE}"
          echo "   - Install MetalLB: ${params.INSTALL_METALLB}"
          echo "   - Install Ingress: ${params.INSTALL_INGRESS}"
          echo "   - Enable Autoscaling: ${params.ENABLE_AUTOSCALING}"
        }
      }
    }

    stage('📥 Code Checkout') {
      steps {
        script {
          echo "🔍 Checking out code from branch: ${params.BRANCH}"
          git url: 'git@github.com:bogdandragosvasile/k8s-libvirt-cluster.git',
              branch: params.BRANCH,
              credentialsId: 'github-ssh-key'
          
          // Display commit information
          def commit = sh(script: 'git log -1 --pretty=format:"%h - %s (%an)"', returnStdout: true).trim()
          echo "📝 Latest commit: ${commit}"
        }
      }
    }

    stage('🔧 Infrastructure Setup') {
      when { 
        expression { 
          !params.SKIP_TERRAFORM && (params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'infrastructure-only') 
        } 
      }
      parallel {
        stage('📦 Prepare Base Image') {
          steps {
            script {
              echo "🖼️  Preparing Ubuntu 24.04 base image..."
              BASE_IMAGE_PATH="/var/lib/libvirt/images/ubuntu-24.04-server-cloudimg-amd64.img"
              BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
              
              if (fileExists(BASE_IMAGE_PATH)) {
                echo "✅ Base image already exists - skipping download"
              } else {
                echo "⬇️  Downloading base image..."
                sh """
                  wget "$BASE_IMAGE_URL" -O "$BASE_IMAGE_PATH" --progress=dot:giga
                  chmod 666 "$BASE_IMAGE_PATH" || true
                  chown 107:107 "$BASE_IMAGE_PATH" || true
                """
                echo "✅ Base image downloaded successfully"
              }
            }
          }
        }
        
        stage('🏊 Setup Libvirt Pool') {
          steps {
            script {
              echo "🏊 Configuring libvirt storage pool..."
              sh '''
                virsh pool-define-as default dir --target /var/lib/libvirt/images || true
                virsh pool-start default || true
                virsh pool-autostart default || true
                echo "✅ Libvirt pool configured successfully"
              '''
            }
          }
        }
      }
    }

    stage('🏗️ Terraform Infrastructure') {
      when { 
        expression { 
          !params.SKIP_TERRAFORM && (params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'infrastructure-only') 
        } 
      }
      stages {
        stage('🔧 Terraform Init') {
          steps {
            dir('terraform') {
              script {
                echo "🔧 Initializing Terraform..."
                sh 'terraform init'
                echo "✅ Terraform initialized successfully"
              }
            }
          }
        }
        
        stage('📋 Terraform Plan') {
          steps {
            dir('terraform') {
              script {
                echo "📋 Creating Terraform execution plan..."
                sh """
                  terraform plan \\
                    -var="kube_ssh_public_key=${KUBE_SSH_PUBLIC_KEY}" \\
                    -var="enable_autoscaling=${params.ENABLE_AUTOSCALING}" \\
                    -out=plan.tfout
                """
                echo "✅ Terraform plan created successfully"
              }
            }
          }
        }
        
        stage('🚀 Terraform Apply') {
          steps {
            dir('terraform') {
              script {
                echo "🚀 Applying Terraform infrastructure..."
                sh 'terraform apply -auto-approve plan.tfout'
                echo "✅ Infrastructure deployed successfully"
              }
            }
          }
        }
        
        stage('📝 Generate Inventory') {
          steps {
            dir('terraform') {
              script {
                echo "📝 Generating Ansible inventory from Terraform outputs..."
                sh 'terraform output -json > outputs.json && cat outputs.json'
                
                sh '''
                  echo "📋 Preserving original vars.yaml and appending Terraform outputs"
                  
                  # Show original vars.yaml
                  echo "Original vars.yaml:"
                  cat ansible/vars.yaml
                  
                  # Append Terraform outputs to existing vars.yaml
                  echo "" >> ansible/vars.yaml
                  echo "# Terraform VM outputs:" >> ansible/vars.yaml
                  jq -r 'to_entries | map("\\(.key): \\(.value.value)") | join("\\n")' terraform/outputs.json >> ansible/vars.yaml
                  
                  echo "Final vars.yaml with Terraform outputs:"
                  cat ansible/vars.yaml
                  
                  echo "Inventory file:"
                  ls -l ansible/inventory.ini
                  cat ansible/inventory.ini
                '''
                echo "✅ Ansible inventory generated successfully"
              }
            }
          }
        }
      }
    }

    stage('🔌 Configuration Management') {
      when { 
        expression { 
          !params.SKIP_ANSIBLE && (params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'configuration-only') 
        } 
      }
      stages {
        stage('⏳ Wait for SSH Connectivity') {
          steps {
            script {
              echo "⏳ Waiting for VMs to be reachable via SSH..."
              MAX_RETRIES=60
              SLEEP_TIME=10
              
              sh """
                cd terraform
                for host in \$(jq -r '.vm_ips.value | to_entries | map(.value) | .[]' outputs.json); do
                  echo "🔍 Checking SSH access on \$host..."
                  for i in \$(seq 1 \$MAX_RETRIES); do
                    if ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \\
                      -i /root/.ssh/id_ed25519 -o ConnectTimeout=3 ubuntu@\$host 'true' 2>/dev/null; then
                      echo "✅ \$host reachable via SSH"
                      break
                    fi
                    echo "⏳ Waiting for \$host... (\$i/\$MAX_RETRIES)"
                    sleep \$SLEEP_TIME
                  done
                  if [ \$i -eq \$MAX_RETRIES ]; then
                    echo "❌ \$host not reachable via SSH"
                    exit 1
                  fi
                done
              """
              echo "✅ All VMs are reachable via SSH"
            }
          }
        }
        
        stage('⚙️ Run Ansible Playbook') {
          steps {
            dir('ansible') {
              script {
                echo "⚙️ Running Ansible configuration management..."
                try {
                  sh '''
                    echo "🔧 Ansible Setup - Enhanced Error Detection"
                    
                    # Set strict error handling
                    set -euo pipefail
                    
                    # Run playbook with enhanced verbose output and error detection
                    ANSIBLE_HOST_KEY_CHECKING=False \\
                    ANSIBLE_STDOUT_CALLBACK=yaml \\
                    ansible-playbook -i ${ANSIBLE_INVENTORY} main.yaml \\
                      --extra-vars "@vars.yaml" \\
                      -vvv \\
                      --diff
                    
                    # Verify the deployment was successful
                    echo "🔍 Post-Deployment Verification"
                    ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
                      -a "kubectl get nodes" \\
                      --extra-vars "@vars.yaml" || true
                  '''
                  echo "✅ Ansible playbook completed successfully"
                } catch (Exception e) {
                  echo "❌ Ansible playbook failed: ${e.getMessage()}"
                  
                  // Collect diagnostic information
                  sh '''
                    echo "🔍 Collecting Diagnostic Information"
                    
                    # Check if any nodes are accessible
                    ansible -i ${ANSIBLE_INVENTORY} all -m ping --extra-vars "@vars.yaml" || true
                    
                    # Check kubelet status on all nodes
                    echo "🔍 Checking kubelet status"
                    ansible -i ${ANSIBLE_INVENTORY} all -m shell \\
                      -a "sudo systemctl status kubelet" \\
                      --extra-vars "@vars.yaml" || true
                    
                    # Check if control plane is working
                    echo "🔍 Checking control plane status"
                    ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
                      -a "kubectl get nodes" \\
                      --extra-vars "@vars.yaml" || true
                  '''
                  
                  // Re-throw the exception to fail the build
                  throw e
                }
              }
            }
          }
        }
      }
    }

    stage('🔍 Cluster Verification') {
      when { 
        expression { 
          !params.SKIP_ANSIBLE && (params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'configuration-only') 
        } 
      }
      steps {
        dir('ansible') {
          script {
            echo "🔍 Verifying cluster status..."
            
            sh '''
              echo "📊 Final Cluster Verification"
              
              # Get cluster status
              ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
                -a "kubectl get nodes -o wide" \\
                --extra-vars "@vars.yaml"
              
              # Get pod status
              ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
                -a "kubectl get pods --all-namespaces" \\
                --extra-vars "@vars.yaml"
              
              # Check cluster info
              ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
                -a "kubectl cluster-info" \\
                --extra-vars "@vars.yaml"
            '''
            echo "✅ Cluster verification completed"
          }
        }
      }
    }

    stage('🚀 Autoscaling Installation') {
      when { 
        expression { 
          params.ENABLE_AUTOSCALING && (params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'autoscaling-only') 
        } 
      }
      stages {
        stage('📊 Install HPA and Metrics Server') {
          steps {
            script {
              echo "📊 Installing Horizontal Pod Autoscaler and Metrics Server..."
              
              sh '''
                # Get control plane IP
                CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
                echo "🎯 Control plane IP: $CONTROL_PLANE_IP"
                
                # Copy the HPA installation script
                scp -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 scripts/install-hpa.sh ubuntu@${CONTROL_PLANE_IP}:/tmp/
                
                # Make it executable and run it
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "chmod +x /tmp/install-hpa.sh && /tmp/install-hpa.sh"
                
                echo "🎉 HPA and Metrics Server installation completed successfully!"
              '''
            }
          }
        }
        
        stage('⚖️ Install Cluster Autoscaler') {
          steps {
            script {
              echo "⚖️ Installing Cluster Autoscaler..."
              
              sh '''
                # Get control plane IP
                CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
                echo "🎯 Control plane IP: $CONTROL_PLANE_IP"
                
                # Copy the cluster autoscaler installation script
                scp -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 scripts/install-cluster-autoscaler.sh ubuntu@${CONTROL_PLANE_IP}:/tmp/
                
                # Make it executable and run it
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "chmod +x /tmp/install-cluster-autoscaler.sh && /tmp/install-cluster-autoscaler.sh"
                
                echo "🎉 Cluster Autoscaler installation completed successfully!"
              '''
            }
          }
        }
        
        stage('🔧 Verify Autoscaling Components') {
          steps {
            script {
              echo "🔧 Verifying autoscaling components..."
              
              sh '''
                # Get control plane IP
                CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
                echo "🎯 Control plane IP: $CONTROL_PLANE_IP"
                
                # Verify metrics server
                echo "📊 Checking Metrics Server..."
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "kubectl get pods -n kube-system | grep metrics-server"
                
                # Verify cluster autoscaler
                echo "⚖️ Checking Cluster Autoscaler..."
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "kubectl get pods -n cluster-autoscaler"
                
                # Verify HPA
                echo "📈 Checking HPA..."
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "kubectl get hpa -A"
                
                # Show resource usage
                echo "📊 Resource Usage:"
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "kubectl top nodes"
                
                echo "✅ Autoscaling components verified successfully!"
              '''
            }
          }
        }
      }
    }

    stage('🔌 Addons Installation') {
      when { 
        expression { 
          params.DEPLOYMENT_TYPE == 'full' || params.DEPLOYMENT_TYPE == 'addons-only' 
        } 
      }
      parallel {
        stage('⚖️ Install MetalLB') {
          when { expression { params.INSTALL_METALLB } }
          steps {
            script {
              echo "⚖️ Installing and configuring MetalLB..."
              
              sh '''
                # Get control plane IP
                CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
                echo "🎯 Control plane IP: $CONTROL_PLANE_IP"
                
                # Test SSH connection
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "echo 'SSH connection successful'"
                
                # Copy the MetalLB installation script
                scp -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 scripts/install-metallb.sh ubuntu@${CONTROL_PLANE_IP}:/tmp/
                
                # Make it executable and run it
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "chmod +x /tmp/install-metallb.sh && /tmp/install-metallb.sh"
                
                echo "🎉 MetalLB installation completed successfully!"
              '''
            }
          }
        }
        
        stage('🌐 Install Nginx Ingress') {
          when { expression { params.INSTALL_INGRESS } }
          steps {
            script {
              echo "🌐 Installing Nginx Ingress Controller..."
              
              sh '''
                # Get control plane IP
                CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
                echo "🎯 Control plane IP: $CONTROL_PLANE_IP"
                
                # Copy the ingress installation script
                scp -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 scripts/install-nginx-ingress.sh ubuntu@${CONTROL_PLANE_IP}:/tmp/
                
                # Make it executable and run it
                ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} \\
                  "chmod +x /tmp/install-nginx-ingress.sh && /tmp/install-nginx-ingress.sh"
                
                echo "🎉 Nginx Ingress Controller installation completed successfully!"
              '''
            }
          }
        }
      }
    }

    stage('📊 Final Summary') {
      steps {
        script {
          echo "📊 Generating final deployment summary..."
          
          sh '''
            echo "=================================="
            echo "🎉 KUBERNETES CLUSTER SUMMARY"
            echo "=================================="
            
            # Get control plane IP
            CONTROL_PLANE_IP=$(grep -A1 "control_plane_init" ansible/inventory.ini | grep -E "^[0-9]" | awk '{print $1}')
            
            echo "📊 CLUSTER STATUS:"
            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get nodes -o wide"
            
            echo "🚀 SYSTEM PODS:"
            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get pods -n kube-system"
            
            echo "⚖️ METALLB STATUS:"
            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get pods -n metallb-system" || echo "MetalLB not installed"
            
            echo "🌐 SERVICES WITH EXTERNAL IPs:"
            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get svc --all-namespaces -o wide | grep -E 'LoadBalancer|EXTERNAL-IP'" || echo "No LoadBalancer services found"
            
            # Show autoscaling status if enabled
            if [ "${params.ENABLE_AUTOSCALING}" = "true" ]; then
              echo "🚀 AUTOSCALING STATUS:"
              ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get hpa -A" || echo "No HPA found"
              ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl get pods -n cluster-autoscaler" || echo "Cluster autoscaler not found"
              ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 ubuntu@${CONTROL_PLANE_IP} "kubectl top nodes" || echo "Metrics server not available"
            fi
            
            echo "✅ Your Kubernetes cluster is ready!"
          '''
          
          // Update build description with final status
          currentBuild.description += "<br/>✅ Deployment completed successfully<br/>Cluster Status: Ready"
          if (params.ENABLE_AUTOSCALING) {
            currentBuild.description += "<br/>🚀 Autoscaling: Enabled"
          }
        }
      }
    }
  }

  post {
    always {
      script {
        // Collect logs regardless of success/failure
        dir('ansible') {
          sh '''
            echo "📋 Collecting Final Logs"
            
            # Show final cluster state
            ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell \\
              -a "kubectl get nodes" \\
              --extra-vars "@vars.yaml" || echo "Could not get cluster status"
            
            echo "Pipeline completed at $(date)"
          '''
        }
        
        // Add build result to description
        def result = currentBuild.result ?: 'SUCCESS'
        def status = result == 'SUCCESS' ? '✅' : '❌'
        currentBuild.description += "<br/>${status} Build Result: ${result}"
        
        echo "Pipeline completed with result: ${result}"
      }
    }
    
    success {
      script {
        echo '🎉 SUCCESS: Kubernetes cluster deployment completed successfully!'
        
        // Send success notification
        sh '''
          echo "🎉 Deployment Summary:"
          echo "   - Deployment Type: ${params.DEPLOYMENT_TYPE}"
          echo "   - Branch: ${params.BRANCH}"
          echo "   - Build Number: ${env.BUILD_NUMBER}"
          echo "   - Duration: ${currentBuild.durationString}"
          echo "   - Status: SUCCESS"
          echo "   - Autoscaling: ${params.ENABLE_AUTOSCALING}"
        '''
      }
    }
    
    failure {
      script {
        echo '❌ FAILURE: Pipeline failed - collecting diagnostic information'
        
        // Enhanced cleanup and diagnostics on failure
        sh '''
          echo "🔍 Cleanup on Failure"
          
          # Show what infrastructure exists
          cd terraform && terraform show || true
          
          # Show recent logs
          echo "📋 Recent system logs:"
          journalctl -n 50 --no-pager || true
        '''
        
        // Update build description with failure info
        currentBuild.description += "<br/>❌ Build failed - check logs for details"
      }
    }
    
    cleanup {
      script {
        echo "🧹 Cleaning up workspace..."
        // Clean up temporary files
        sh 'rm -f terraform/plan.tfout terraform/outputs.json || true'
      }
    }
  }
}
