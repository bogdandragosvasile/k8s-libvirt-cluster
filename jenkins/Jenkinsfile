pipeline {
  agent any

  parameters {
    booleanParam(name: 'SKIP_TERRAFORM', defaultValue: true, description: 'Skip Terraform stages')
    booleanParam(name: 'SKIP_ANSIBLE', defaultValue: true, description: 'Skip Ansible stages')
    booleanParam(name: 'INSTALL_METALLB', defaultValue: true, description: 'Install MetalLB')
    booleanParam(name: 'INSTALL_INGRESS', defaultValue: true, description: 'Install Nginx Ingress Controller with MetalLB integration')
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    LIBVIRT_URI          = 'qemu:///system'
    ANSIBLE_INVENTORY    = 'inventory.ini'
    KUBE_SSH_PUBLIC_KEY  = credentials('kube-ssh-public-key')
    ANSIBLE_HOST_KEY_CHECKING = 'False'
    ANSIBLE_STDOUT_CALLBACK   = 'yaml'
    SSH_KEY_PATH         = '/var/lib/jenkins/.ssh/id_ed25519'
  }

  stages {
    stage('Ensure Libvirt Default Pool') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        script {
          int retries = 5
          for (int i = 1; i <= retries; i++) {
            try {
              sh '''
                set -e
                if virsh pool-info default >/dev/null 2>&1; then
                  echo "Default pool already exists."
                else
                  echo "Defining default storage pool..."
                  virsh pool-define-as default dir --target /var/lib/libvirt/images
                fi

                STATE=$(virsh pool-info default | grep State | awk '{print $2}')
                if [ "$STATE" != "running" ]; then
                  echo "Starting default storage pool..."
                  virsh pool-start default
                else
                  echo "Default storage pool is already running."
                fi

                AUTOSTART=$(virsh pool-info default | grep Autostart | awk '{print $2}')
                if [ "$AUTOSTART" != "yes" ]; then
                  echo "Enabling autostart for default storage pool..."
                  virsh pool-autostart default
                else
                  echo "Autostart already enabled for default storage pool."
                fi

                # Verify libvirt socket exists and Jenkins user group membership
                LIBVIRT_SOCK=/var/run/libvirt/libvirt-sock
                if [ ! -e "$LIBVIRT_SOCK" ]; then
                  echo "Libvirt socket $LIBVIRT_SOCK missing!"
                  exit 1
                fi
                ls -l $LIBVIRT_SOCK

                if groups jenkins | grep -qw libvirt; then
                  echo "Jenkins user in libvirt group: OK."
                else
                  echo "WARNING: Jenkins user NOT in libvirt group. This may cause permission issues."
                fi
              '''
              break
            } catch (e) {
              echo "Attempt ${i} to ensure libvirt default pool failed: ${e}"
              if (i < retries) {
                echo 'Retrying in 5 seconds...'
                sleep 5
              } else {
                error "Failed to prepare libvirt default pool after ${retries} attempts."
              }
            }
          }
        }
      }
    }

    stage('Prepare Base Image') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        sh '''
          echo "[Prepare Base Image]"
          BASE_IMAGE_PATH="/var/lib/libvirt/images/ubuntu-24.04-server-cloudimg-amd64.img"
          BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"

          if [ ! -f "$BASE_IMAGE_PATH" ]; then
            echo "Downloading base image..."
            wget "$BASE_IMAGE_URL" -O "$BASE_IMAGE_PATH" --progress=dot:giga
          else
            echo "Base image already exists, skipping download."
          fi

          chmod 666 "$BASE_IMAGE_PATH" || true
          # chown ignored due to permissions, ensure manual correct ownership
        '''
      }
    }

    stage('Checkout Code') {
      steps {
        git url: 'git@github.com:bogdandragosvasile/k8s-libvirt-cluster.git',
            branch: 'local',
            credentialsId: 'github-ssh-key'
      }
    }

    stage('Terraform Init') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform init'
        }
      }
    }

    stage('Terraform Plan') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh "terraform plan -var=kube_ssh_public_key=${KUBE_SSH_PUBLIC_KEY} -out=plan.tfout"
        }
      }
    }

    stage('Terraform Apply') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform apply -auto-approve plan.tfout'
        }
      }
    }

    stage('Generate Ansible Inventory') {
      when { expression { !params.SKIP_TERRAFORM } }
      steps {
        dir('terraform') {
          sh 'terraform output -json > outputs.json'
        }
        sh '''
          echo "Appending Terraform outputs to ansible/vars.yaml"
          # Append outputs in key: value format safely
          jq -r 'to_entries| map("\\(.key): \\(.value.value)") | .[]' terraform/outputs.json >> ansible/vars.yaml
          echo "vars.yaml after append:"
          cat ansible/vars.yaml
        '''
      }
    }

    stage('Wait for VMs SSH Reachability') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        sh '''
          echo "Wait for SSH access on provisioned VMs"
          MAX_RETRIES=60
          SLEEP=10

          for ip in $(jq -r '.vm_ips | to_entries[].value' terraform/outputs.json); do
            echo "Waiting for SSH on $ip"
            for i in $(seq 1 $MAX_RETRIES); do
              ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i ${SSH_KEY_PATH} ubuntu@$ip true && break
              echo "SSH not ready on $ip - retry $i/$MAX_RETRIES"
              sleep $SLEEP
            done
            if [ $i -eq $MAX_RETRIES ]; then
              echo "ERROR: SSH not reachable on $ip after $MAX_RETRIES attempts"
              exit 1
            fi
          done
        '''
      }
    }

    stage('Run Ansible Playbook') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        dir('ansible') {
          sh '''
            ansible-playbook -i ${ANSIBLE_INVENTORY} main.yaml --extra-vars @vars.yaml -vvv --diff
          '''
        }
      }
    }

    stage('Verify Cluster Status') {
      when { expression { !params.SKIP_ANSIBLE } }
      steps {
        dir('ansible') {
          sh '''
            ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell -a "kubectl get nodes -o wide" --extra-vars @vars.yaml
            ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell -a "kubectl get pods --all-namespaces" --extra-vars @vars.yaml
            ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell -a "kubectl cluster-info" --extra-vars @vars.yaml
          '''
        }
      }
    }

    stage('Install MetalLB') {
      when { expression { params.INSTALL_METALLB } }
      steps {
        sh '''
          CONTROL_PLANE_IP=$(ansible -i ansible/inventory.ini control_plane_init --list-hosts | tail -1)
          scp -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} scripts/install-metallb.sh ubuntu@$CONTROL_PLANE_IP:/tmp/
          ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ubuntu@$CONTROL_PLANE_IP "chmod +x /tmp/install-metallb.sh && /tmp/install-metallb.sh"
          echo "MetalLB installation complete."
        '''
      }
    }

    stage('Install Nginx Ingress Controller') {
      when { expression { params.INSTALL_INGRESS } }
      steps {
        sh '''
          CONTROL_PLANE_IP=$(ansible -i ansible/inventory.ini control_plane_init --list-hosts | tail -1)
          scp -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} scripts/install-nginx-ingress.sh ubuntu@$CONTROL_PLANE_IP:/tmp/
          ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ubuntu@$CONTROL_PLANE_IP "chmod +x /tmp/install-nginx-ingress.sh && /tmp/install-nginx-ingress.sh"
          echo "Nginx Ingress installation complete."
        '''
      }
    }

    stage('Final Cluster Summary') {
      steps {
        sh '''
          CONTROL_PLANE_IP=$(ansible -i ansible/inventory.ini control_plane_init --list-hosts | tail -1)
          ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ubuntu@$CONTROL_PLANE_IP "kubectl get nodes -o wide"
          ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ubuntu@$CONTROL_PLANE_IP "kubectl get pods -n kube-system"
          ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ubuntu@$CONTROL_PLANE_IP "kubectl get pods -n metallb-system" || echo "MetalLB not installed"
        '''
      }
    }
  }

  post {
    always {
      dir('ansible') {
        sh '''
          echo "Collecting final cluster logs"
          ansible -i ${ANSIBLE_INVENTORY} control_plane_init -m shell -a "kubectl get nodes" --extra-vars @vars.yaml || echo "Could not get nodes status"
        '''
      }
      echo 'Pipeline completed.'
    }

    success {
      echo '\033[32m[SUCCESS] Kubernetes cluster deployment finished!\033[0m'
    }

    failure {
      echo '\033[31m[FAILURE] Pipeline failed, please check logs.\033[0m'
    }
  }
}
